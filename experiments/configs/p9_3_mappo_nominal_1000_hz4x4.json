{
  "name": "p9_3_mappo_nominal_1000",
  "seeds": [101, 202, 303, 404, 505],
  "checkpoint_dir": "output/checkpoints",
  "output_dir": "output/p9_3_runs",
  "defaults": {
    "train_episodes": 1000,
    "eval_episodes": 3,
    "max_steps": 360,
    "delta_time": 10,
    "control_mode": "acyclic",
    "global_reward_fn": "queue_length",
    "compare_with": ["random", "max_pressure"]
  },
  "environments": [
    { "id": "cf_hz4x4", "backend": "cityflow", "config": "../../configs/sim/cityflow4x4.json" }
  ],
  "agents": [
    { "id": "mappo", "type": "mappo",
      "params": { "lr": 0.0003, "rollout_size": 1024, "minibatch_size": 128, "hidden_dim": 128 } }
  ]
}
