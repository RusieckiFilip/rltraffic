{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Edit(envs/**)",
      "Edit(agent/base.py)",
      "Edit(agent/utils/utils.py)",
      "Edit(agent/MAPPOAgent.py)",
      "Edit(algorithms/**)",
      "Edit(rewards.py)",
      "Edit(states/**)",
      "Edit(metrics/**)",
      "Edit(utils/**)",
      "Edit(scripts/**)",
      "Edit(.claude/**)",
      "Edit(CityFlow/**)",
      "Edit(experiments/*.py)",
      "Edit(experiments/**/*.py)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git reset --hard:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",         
      "Bash(git merge:*)",              
      "Bash(git checkout main:*)",
      "Bash(pip install:*)",
      "Bash(conda install:*)",
      "Bash(conda create:*)",
      "Bash(rm:*)"
    ],
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(python -m offline.collect:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude_guard.sh\" --frozen-only"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude_guard.sh\" --tests-only"
          }
        ]
      }
    ]
  }
}
